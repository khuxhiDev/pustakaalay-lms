PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/pustakaalay_lms
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
CLIENT_URL=http://localhost:5173
# Required to create the sample accounts and run API smoke tests. Keep actual value only in .env.
DEMO_PASSWORD=
